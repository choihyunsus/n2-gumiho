{
  "name": "n2-gumiho",
  "version": "1.0.0",
  "description": "Provider-independent agent tails with durable jobs, bounded execution and artifact-bound verification over the common Soul database.",
  "main": "dist/library.js",
  "types": "dist/library.d.ts",
  "exports": {
    ".": { "types": "./dist/library.d.ts", "require": "./dist/library.js", "import": "./dist/library.js" },
    "./package.json": "./package.json",
    "./examples/*": "./examples/*"
  },
  "bin": { "n2-gumiho": "dist/index.js" },
  "files": ["dist/", "examples/", "LICENSE", "LICENSE-*", "THIRD-PARTY-NOTICES", "README.md", "README.ko.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck false tests/consumer.mts tests/consumer.cts",
    "test": "npm run build && node --test --test-timeout=30000 tests/*.test.cjs",
    "prepack": "npm test"
  },
  "engines": { "node": ">=22.0.0" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/choihyunsus/n2-gumiho" },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "n2-recipe": "https://github.com/choihyunsus/n2-recipe/releases/download/v1.0.0/n2-recipe-1.0.0.tgz",
    "n2-mimir": "https://github.com/choihyunsus/n2-mimir/releases/download/v3.0.3/n2-mimir-3.0.3.tgz",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": { "@types/better-sqlite3": "7.6.13", "@types/node": "^22.20.5", "typescript": "^5.9.3" }
}
